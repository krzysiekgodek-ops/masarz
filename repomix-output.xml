  >
    {children}
  </button>
);

const Sep = () => <div className="w-px h-5 bg-[#3a3226] mx-0.5 self-center" />;

const RichTextEditor = ({ value, onChange, placeholder = 'Opis procesu produkcyjnego...' }) => {
