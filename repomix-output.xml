                          )}
                          {ad.targetUrl && (
                            <span className="flex items-center gap-1">
                              {isPdf ? <FileText size={9} /> : <ExternalLink size={9} />}
                              <span className="truncate max-w-[120px]">{ad.targetUrl}</span>
                            </span>
